/-
# Bare Grammar demo — step through in VS Code

Open this folder (`playground/`) in VS Code with the Lean 4 extension.
Put the cursor at the end of each line inside a proof; the infoview shows the
hypotheses (expressions built so far) and the goal.

These are the three levels of the online demo, without the game interface.
-/
import BareSyntax

set_option linter.unusedVariables false

open BareSyntax

/-! ## Level 1 — a linear grammar

`linear₁`: lexicon ⟨a, D⟩ ⟨very, Adv⟩ ⟨good, A⟩ ⟨day, N⟩; rules N → D N, N → D A N. -/
example (a : (["a"], Linear1Cat.D) ∈ linear₁.lexicon)
    (very : (["very"], Linear1Cat.Adv) ∈ linear₁.lexicon)
    (good : (["good"], Linear1Cat.A) ∈ linear₁.lexicon)
    (day : (["day"], Linear1Cat.N) ∈ linear₁.lexicon) :
    CanYield linear₁ ["a", "good", "day"] .N := by
  rule "N -> D A N" a good day

/-! ## Level 2 — X-bar theory with GB

The rule table is generated by the X-bar schema from GB data (c-selection, Case
positions, EPP). T′ → T⁰ VP lowers the affix: see + -s = sees. -/
example (the : (["the"], x0 .D) ∈ xbarGB.lexicon)
    (cat : (["cat"], x0 .N) ∈ xbarGB.lexicon)
    (dog : (["dog"], x0 .N) ∈ xbarGB.lexicon)
    (see : (["see"], x0 .V) ∈ xbarGB.lexicon)
    (s : (["-s"], x0 .T) ∈ xbarGB.lexicon) :
    CanYield xbarGB ["the", "cat", "sees", "the", "dog"] (xp .T) := by
  rule "N' -> N0" cat
  rule "NP -> N'" cat_N'
  rule "D' -> D0 NP" the cat_NP
  rule "DP -> D'" the_cat_D'
  rule "N' -> N0" dog
  rule "NP -> N'" dog_N'
  rule "D' -> D0 NP" the dog_NP
  rule "DP -> D'" the_dog_D'
  rule "V' -> V0 DP" see the_dog_DP
  rule "VP -> V'" see_the_dog_V'
  rule "T' -> T0 VP" s see_the_dog_VP
  rule "TP -> DP T'" the_cat_DP sees_the_dog_T'

/-! ## Level 3 — the Minimalist Program, workspace era

An expression is a workspace; MERGE(P, Q, WS) = [{P, Q}, …] (Chomsky 2020).
Labels by a labeling algorithm after Chomsky 2013. Only narrow syntax is done
by hand; externalization is checked automatically after the last step. -/
example : MP.Converges ["the", "cat", "will", "sleep"] := by
  select the n cat will v sleep
  merge n cat
  merge the nP
  merge v sleep
  merge DP vP
  merge will {DP, vP}     -- one object left, but {DP, vP} has no label
  merge DP TP             -- Internal MERGE: the lower DP becomes a copy

/-! ## Rejections

Uncomment one line at a time to see how the grammar rejects a step. -/
example (a : (["a"], Linear1Cat.D) ∈ linear₁.lexicon)
    (good : (["good"], Linear1Cat.A) ∈ linear₁.lexicon)
    (day : (["day"], Linear1Cat.N) ∈ linear₁.lexicon) :
    CanYield linear₁ ["a", "good", "day"] .N := by
  -- rule "N -> D N" a good day        -- the rule's domain is D, N
  rule "N -> D A N" a good day
