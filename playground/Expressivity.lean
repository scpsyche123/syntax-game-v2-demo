import BareSyntax

/-!
Exploratory formalization of expressive-power questions (2026-11-21).
These are elementary consequences of the CURRENT toy model, not claims
about the Minimalist Program or Keenan–Stabler in general.
-/

open BareSyntax

namespace ExpressivityPilot

private def a : MP.SO := .li .toto
private def b : MP.SO := .li .lala

-- MP.SO.set is a binary constructor, not a mathematically unordered pair.
theorem merge_constructor_remembers_order :
    MP.SO.set a b ≠ MP.SO.set b a := by
  decide

theorem merge_rule_accepts_both_orders :
    MP.mergeWS a b [a, b] = some [MP.SO.set a b] ∧
    MP.mergeWS b a [a, b] = some [MP.SO.set b a] := by
  decide

theorem merge_yields_different_order :
    MP.ext (MP.SO.set a b) (MP.SO.set a b) 0 = ["toto", "lala"] ∧
    MP.ext (MP.SO.set b a) (MP.SO.set b a) 0 = ["lala", "toto"] := by
  decide

-- The ambient FRule definition places no bound on Arg or output provenance.
def unrestrictedRule : FRule Unit (List String) where
  name := "unrestricted generator"
  apply := fun s ins =>
    match ins with
    | [] => some (s, ())
    | _ => none

def unrestrictedGrammar : BareGrammar where
  Cat := Unit
  decCat := inferInstance
  lexicon := []
  rules := []
  Arg := List String
  frules := [unrestrictedRule]

-- Every string is directly generated by choosing it as the rule argument.
theorem all_strings_generated (s : List String) :
    CanYield unrestrictedGrammar s () := by
  unfold CanYield
  refine ⟨Deriv.fapp (G := unrestrictedGrammar) (r := unrestrictedRule) (inputs := []) (out := (s, ())) s ?_ ?_ ?_⟩
  · simp [unrestrictedGrammar]
  · exact DerivList.nil
  · rfl

-- A mathematically unordered pair of two distinct atoms is fixed by
-- swapping them; neither of its two possible enumerations is fixed.
theorem swap_cannot_fix_an_ordered_pair (xs : List Bool)
    (h_enum : xs = [true, false] ∨ xs = [false, true])
    (h_fixed : xs.map Bool.not = xs) : False := by
  rcases h_enum with h | h
  · simp [h] at h_fixed
  · simp [h] at h_fixed

-- Unit stands for the *one* unordered two-element object, fixed by swapping
-- the atoms; its alleged order must enumerate both distinct atoms.
theorem no_equivariant_orderer (order : Unit → List Bool)
    (h_enum : order () = [true, false] ∨ order () = [false, true])
    (h_equivariant : (order ()).map Bool.not = order ()) : False :=
  swap_cannot_fix_an_ordered_pair (order ()) h_enum h_equivariant

end ExpressivityPilot
